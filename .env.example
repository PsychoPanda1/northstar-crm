# Copy this file to .env or your deployment secret store. Never commit real values.
NODE_ENV=production
PORT=4173

# Use a unique random value with at least 32 characters.
NORTHSTAR_SESSION_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_DATA_FILE=/app/data/state.json
NORTHSTAR_SESSION_FILE=/app/data/state.json.sessions
# Optional production single-host transactional store; the container enables this by default.
NORTHSTAR_SQLITE_FILE=/app/data/northstar.sqlite
NORTHSTAR_REQUIRE_SQLITE=true
# Last-known-good SQLite backup refreshed after each state write in production.
NORTHSTAR_BACKUP_FILE=/app/data/northstar.sqlite.backup

# Single-owner setup. Generate a salted scrypt digest with:
#   node scripts/generate-owner-digest.mjs
NORTHSTAR_OWNER_EMAIL=owner@example.com
NORTHSTAR_OWNER_PASSWORD_DIGEST=replace-with-scrypt-digest
NORTHSTAR_OWNER_TENANT_ID=your-tenant-slug
NORTHSTAR_OWNER_NAME=Workspace owner

# Optional production OIDC exchange. Provision each subject explicitly;
# tenant and role are never trusted from token claims.
NORTHSTAR_OIDC_ISSUER=
NORTHSTAR_OIDC_AUDIENCE=
NORTHSTAR_OIDC_JWKS_URL=
NORTHSTAR_OIDC_ACCOUNTS_JSON='[]'

# Keep tenant and service mappings aligned with the landing pages that call this CRM.
NORTHSTAR_TENANTS_JSON='[{"slug":"your-tenant-slug","businessName":"Your Business","serviceLabel":"Your Service","timeZone":"America/New_York","contactPhone":"(843) 555-0100","contactEmail":"hello@your-business.example","serviceArea":"Charleston area","requestResponseSlaHours":24,"intakeFields":[{"id":"service_details","type":"textarea","label":"What do you need help with?","required":true}]}]'
NORTHSTAR_SERVICE_TENANTS_JSON='{"your-service":"your-tenant-slug"}'
NORTHSTAR_CATALOG_JSON='[{"tenantId":"your-tenant-slug","id":"service-inspection","name":"Service inspection","description":"Diagnostic visit and written recommendations","priceFrom":"$149","category":"Inspection","durationMinutes":60,"taxable":true}]'
NORTHSTAR_OWNERS_JSON='[]'
NORTHSTAR_STAFF_JSON='[]'
NORTHSTAR_ALLOWED_ORIGINS=https://your-service-site.example
# Optional per-service origin binding for multi-business deployments. When a
# service key is present here, only these origins may submit its lead/booking.
NORTHSTAR_SERVICE_ORIGINS_JSON='{}'

# Optional scheduled reminder worker. Minimum 15 minutes; blank/0 disables it.
NORTHSTAR_AUTOMATION_INTERVAL_MINUTES=0
# Optional recurring-plan billing day. Set 1–28 to enable tenant-local
# monthly invoice creation after this day; blank/0 keeps billing manual.
NORTHSTAR_PLAN_BILLING_DAY=0

# New-lead response SLA in hours. Breached uncontacted leads become urgent.
NORTHSTAR_LEAD_RESPONSE_SLA_HOURS=2
# Customer request response SLA in hours. Older open requests become urgent.
NORTHSTAR_REQUEST_RESPONSE_SLA_HOURS=24
# Open-estimate follow-up age in days. Aging estimates appear in the owner queue.
NORTHSTAR_ESTIMATE_FOLLOWUP_DAYS=3

# Public landing-page mutation limits per client address and service, per minute.
# Defaults are 20 lead/booking submissions and 60 signed-portal mutations.
NORTHSTAR_PUBLIC_LEAD_RATE_LIMIT=20
NORTHSTAR_PUBLIC_MUTATION_RATE_LIMIT=60
# Set true only when the service is directly behind a trusted proxy that
# overwrites X-Forwarded-For; direct socket addresses remain the default.
NORTHSTAR_TRUST_PROXY=false

# All five core webhook secrets are required for production readiness.
NORTHSTAR_PAYMENT_WEBHOOK_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_MESSAGE_WEBHOOK_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_CALL_WEBHOOK_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_FINANCING_WEBHOOK_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_FLEET_WEBHOOK_SECRET=replace-with-32-plus-random-characters
# Optional: keep the prior secret briefly during an external webhook-key rotation.
NORTHSTAR_PAYMENT_WEBHOOK_SECRET_PREVIOUS=
NORTHSTAR_MESSAGE_WEBHOOK_SECRET_PREVIOUS=
NORTHSTAR_CALL_WEBHOOK_SECRET_PREVIOUS=
NORTHSTAR_FINANCING_WEBHOOK_SECRET_PREVIOUS=
NORTHSTAR_FLEET_WEBHOOK_SECRET_PREVIOUS=

# Optional outbound message provider. Leave blank until a real provider is configured.
NORTHSTAR_MESSAGE_PROVIDER_URL=
NORTHSTAR_MESSAGE_PROVIDER_API_KEY=
# Optional outbound estimate/invoice artifact provider. It receives secure PDF
# and browser URLs and must deduplicate using the supplied Idempotency-Key.
NORTHSTAR_DOCUMENT_PROVIDER_URL=
NORTHSTAR_DOCUMENT_PROVIDER_API_KEY=
NORTHSTAR_DOCUMENT_RETRY_LIMIT=0
NORTHSTAR_LEAD_PROVIDER_URL=
NORTHSTAR_LEAD_PROVIDER_API_KEY=
NORTHSTAR_LEAD_RETRY_LIMIT=0
# Optional outbound inventory/warehouse transaction provider.
NORTHSTAR_INVENTORY_PROVIDER_URL=
NORTHSTAR_INVENTORY_PROVIDER_API_KEY=
NORTHSTAR_INVENTORY_RETRY_LIMIT=0
# Optional outbound accounting/ERP transaction provider.
NORTHSTAR_ACCOUNTING_PROVIDER_URL=
NORTHSTAR_ACCOUNTING_PROVIDER_API_KEY=
NORTHSTAR_ACCOUNTING_RETRY_LIMIT=0
# Optional outbound approved payroll-period handoff to a payroll/ERP provider.
NORTHSTAR_PAYROLL_PROVIDER_URL=
NORTHSTAR_PAYROLL_PROVIDER_API_KEY=
NORTHSTAR_PAYROLL_RETRY_LIMIT=0
# Public HTTPS origin used in customer-facing links sent by providers.
NORTHSTAR_PUBLIC_URL=https://crm.example.com
# When true, lead, inventory, accounting, message, and payment provider URLs are required for readiness.
# Production default: keep true. Set false only for an isolated preview/smoke deployment.
NORTHSTAR_REQUIRE_LIVE_PROVIDERS=true
# Automatic retries for transient message-provider failures (0-5 attempts).
NORTHSTAR_MESSAGE_RETRY_LIMIT=0

# Optional outbound payment-intent provider. It must accept the documented
# server-to-server payload and later call the signed payment webhook.
NORTHSTAR_PAYMENT_PROVIDER_URL=
NORTHSTAR_PAYMENT_PROVIDER_API_KEY=
