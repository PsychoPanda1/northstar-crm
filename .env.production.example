# Copy to .env.production and replace every placeholder. Keep this file private.
NORTHSTAR_HOST=crm.example.com
NORTHSTAR_IMAGE=ghcr.io/psychopanda1/northstar-crm:v0.1.54
NORTHSTAR_REQUIRE_LIVE_PROVIDERS=true
PROMETHEUS_RETENTION=15d
NORTHSTAR_BACKUP_MAX_AGE_HOURS=24
# Create this file locally with the same value as NORTHSTAR_METRICS_SECRET:
# secrets/northstar_metrics.secret

# Generate with: node scripts/generate-owner-digest.mjs
NORTHSTAR_SESSION_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_SESSION_SECRET_PREVIOUS=
NORTHSTAR_METRICS_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_OWNER_EMAIL=owner@example.com
NORTHSTAR_OWNER_PASSWORD_DIGEST=replace-with-scrypt-digest
NORTHSTAR_OWNER_TENANT_ID=your-tenant-slug
NORTHSTAR_OWNER_NAME=Workspace owner

# Replace these with the actual tenant, service-key, catalog, and HTTPS origin data.
NORTHSTAR_TENANTS_JSON='[{"slug":"your-tenant-slug","businessName":"Your Business","serviceLabel":"Your Service","timeZone":"America/New_York","contactEmail":"hello@example.com","intakeFields":[{"id":"service_details","type":"textarea","label":"What do you need help with?","required":true}]}]'
NORTHSTAR_SERVICE_TENANTS_JSON='{"your-service":"your-tenant-slug"}'
NORTHSTAR_SERVICE_ORIGINS_JSON='{"your-service":["https://www.example.com"]}'
NORTHSTAR_ALLOWED_ORIGINS=https://www.example.com
NORTHSTAR_CATALOG_JSON='[{"tenantId":"your-tenant-slug","id":"service-inspection","name":"Service inspection","description":"Diagnostic visit and written recommendations","priceFrom":"$149","durationMinutes":60,"taxable":true}]'

# All production webhook secrets must be unique and at least 32 characters.
NORTHSTAR_PAYMENT_WEBHOOK_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_MESSAGE_WEBHOOK_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_CALL_WEBHOOK_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_FINANCING_WEBHOOK_SECRET=replace-with-32-plus-random-characters
NORTHSTAR_FLEET_WEBHOOK_SECRET=replace-with-32-plus-random-characters

# Configure live provider URLs and server-side API keys before accepting traffic.
NORTHSTAR_LEAD_PROVIDER_URL=
NORTHSTAR_LEAD_PROVIDER_API_KEY=
NORTHSTAR_MESSAGE_PROVIDER_URL=
NORTHSTAR_MESSAGE_PROVIDER_API_KEY=
NORTHSTAR_PAYMENT_PROVIDER_URL=
NORTHSTAR_PAYMENT_PROVIDER_API_KEY=
NORTHSTAR_PAYMENT_SETUP_PROVIDER_URL=
NORTHSTAR_PAYMENT_SETUP_PROVIDER_API_KEY=
NORTHSTAR_DOCUMENT_PROVIDER_URL=
NORTHSTAR_DOCUMENT_PROVIDER_API_KEY=
NORTHSTAR_MEDIA_PROVIDER_URL=
NORTHSTAR_MEDIA_PROVIDER_API_KEY=
NORTHSTAR_INVENTORY_PROVIDER_URL=
NORTHSTAR_INVENTORY_PROVIDER_API_KEY=
NORTHSTAR_ACCOUNTING_PROVIDER_URL=
NORTHSTAR_ACCOUNTING_PROVIDER_API_KEY=
NORTHSTAR_PAYROLL_PROVIDER_URL=
NORTHSTAR_PAYROLL_PROVIDER_API_KEY=
